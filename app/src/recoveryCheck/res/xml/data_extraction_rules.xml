<?xml version="1.0" encoding="utf-8"?>
<!--
  The isolated recoveryCheck build, ADR 0009 slice 1B: the same rules as the real app's, for this
  build's own planning file names. It replaces src/main/res/xml/data_extraction_rules.xml in this
  build only.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="recoverycheck-planning.db" />
        <exclude domain="database" path="recoverycheck-planning.db-wal" />
        <exclude domain="database" path="recoverycheck-planning.db-shm" />
        <exclude domain="database" path="recoverycheck-planning.db-journal" />
        <exclude domain="database" path="recoverycheck-planning-restore.db" />
        <exclude domain="database" path="recoverycheck-planning-restore.db-wal" />
        <exclude domain="database" path="recoverycheck-planning-restore.db-shm" />
        <exclude domain="database" path="recoverycheck-planning-restore.db-journal" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed.new" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed.new.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-restore-key.sealed" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-restore-key.sealed.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-replace.journal" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-replace.journal.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-set-aside" />
        <exclude domain="file" path="ai" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="recoverycheck-planning.db" />
        <exclude domain="database" path="recoverycheck-planning.db-wal" />
        <exclude domain="database" path="recoverycheck-planning.db-shm" />
        <exclude domain="database" path="recoverycheck-planning.db-journal" />
        <exclude domain="database" path="recoverycheck-planning-restore.db" />
        <exclude domain="database" path="recoverycheck-planning-restore.db-wal" />
        <exclude domain="database" path="recoverycheck-planning-restore.db-shm" />
        <exclude domain="database" path="recoverycheck-planning-restore.db-journal" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed.new" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-key.sealed.new.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-restore-key.sealed" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-restore-key.sealed.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-replace.journal" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-replace.journal.staging" />
        <exclude domain="root" path="no_backup/recoverycheck-planning-set-aside" />
        <exclude domain="file" path="ai" />
    </device-transfer>
</data-extraction-rules>
